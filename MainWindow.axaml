<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ProteinTracker.MainWindow"
        Title="Protein Tracker"
        Width="500"
        Height="350"
        Background="#F3F4F6">

    <Border Background="White"
            CornerRadius="15"
            Padding="40"
            Margin="40">

        <StackPanel Spacing="20">

            <TextBlock Text="Protein Tracker"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Wie heisst du?"
                       FontSize="18"/>

            <TextBox x:Name="NameInput"
                     Watermark="Name eingeben"/>

            <TextBlock x:Name="FehlerAnzeige"
                       Text=""/>

            <Button Content="Weiter"
                    HorizontalAlignment="Center"
                    Padding="30,10"
                    Click="Weiter_Click"/>

        </StackPanel>

    </Border>

</Window>