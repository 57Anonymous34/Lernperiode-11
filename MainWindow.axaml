<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ProteinTracker.MainWindow"
        Title="Protein Tracker"
        Width="500"
        Height="300">

    <StackPanel Margin="40" Spacing="15">

        <TextBlock Text="Protein Tracker"
                   FontSize="30"
                   FontWeight="Bold"/>

        <TextBlock Text="Tägliches Proteinziel"/>

        <TextBox x:Name="ProteinZielInput"
                 Watermark="Protein in Gramm"/>

    </StackPanel>

</Window>